        "import numpy as np\n",
        "import matplotlib.pyplot as plt\n",
        "\n",
        "x = np.linspace(-1, 1, 100)\n",
        "y = x**2\n",
        "\n",
        "plt.figure(figsize= (5, 3))\n",
        "plt.plot(x, y, label='y=x^2')\n",
        "plt.legend()\n",
        "plt.show()"
      ]
